createOrReplace

	expression DataFolder = "C:\airline-sales-performance-bi\data\model" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	table SalesFlown

		column 'DATA TYPE'
			dataType: string
			summarizeBy: none
			sourceColumn: DATA TYPE

		column 'SERVICE TYPE'
			dataType: string
			summarizeBy: none
			sourceColumn: SERVICE TYPE

		column SUBSERVICE
			dataType: string
			summarizeBy: none
			sourceColumn: SUBSERVICE

		column 'AGEN NO'
			dataType: string
			summarizeBy: none
			sourceColumn: AGEN NO

		column 'AGENT GROUPING'
			dataType: string
			summarizeBy: none
			sourceColumn: AGENT GROUPING

		column POI
			dataType: string
			summarizeBy: none
			sourceColumn: POI

		column 'BRANCH OFFICE'
			dataType: string
			summarizeBy: none
			sourceColumn: BRANCH OFFICE

		column ROUTEVV
			dataType: string
			summarizeBy: none
			sourceColumn: ROUTEVV

		column ROUTE
			dataType: string
			summarizeBy: none
			sourceColumn: ROUTE

		column DATES
			dataType: dateTime
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: DATES

		column 'CORP CODE'
			dataType: string
			summarizeBy: none
			sourceColumn: CORP CODE

		column 'GROUPING CHANNEL'
			dataType: string
			summarizeBy: none
			sourceColumn: GROUPING CHANNEL

		column SUBCLASS
			dataType: string
			summarizeBy: none
			sourceColumn: SUBCLASS

		column 'BO POO'
			dataType: string
			summarizeBy: none
			sourceColumn: BO POO

		column 'CORP NAME'
			dataType: string
			summarizeBy: none
			sourceColumn: CORP NAME

		column 'CORPORATE CLUSTER'
			dataType: string
			summarizeBy: none
			sourceColumn: CORPORATE CLUSTER

		column 'AGENT NAME'
			dataType: string
			summarizeBy: none
			sourceColumn: AGENT NAME

		column 'CORP SHARE'
			dataType: string
			summarizeBy: none
			sourceColumn: CORP SHARE

		column AREA
			dataType: string
			summarizeBy: none
			sourceColumn: AREA

		column 'DATE TRAVEL'
			dataType: dateTime
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: DATE TRAVEL

		column PAX
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: PAX

		column 'NETT USD'
			dataType: double
			formatString: #,0
			summarizeBy: sum
			sourceColumn: NETT USD

		column 'BASIC FARE USD'
			dataType: double
			formatString: #,0
			summarizeBy: sum
			sourceColumn: BASIC FARE USD

		column 'WEEK NUM'
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: WEEK NUM

		column 'Route Status' =
				RELATED ( DimRoute[status] )
			summarizeBy: none

		column 'POO Classification' =
				IF ( SalesFlown[BRANCH OFFICE] = SalesFlown[BO POO], "POO", "Non POO" )
			summarizeBy: none

		column 'Corporate Cluster Group' =
				SWITCH (
				    TRUE (),
				    ISBLANK ( SalesFlown[CORPORATE CLUSTER] ), "(Blank)",
				    SalesFlown[CORPORATE CLUSTER] IN { "GOVERNMENT", "SOE" }, "GOVERNMENT & SOE",
				    SalesFlown[CORPORATE CLUSTER] IN { "CHA/TMC", "PRIVATE" }, "PRIVATE",
				    SalesFlown[CORPORATE CLUSTER]
				)
			summarizeBy: none

		partition SalesFlown = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents(DataFolder & "\fact_sales_flown.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
					    Typed = Table.TransformColumnTypes(Nulls, {{"DATA TYPE", type text}, {"SERVICE TYPE", type text}, {"SUBSERVICE", type text}, {"AGEN NO", type text}, {"AGENT GROUPING", type text}, {"POI", type text}, {"BRANCH OFFICE", type text}, {"ROUTEVV", type text}, {"ROUTE", type text}, {"DATES", type date}, {"CORP CODE", type text}, {"GROUPING CHANNEL", type text}, {"SUBCLASS", type text}, {"BO POO", type text}, {"CORP NAME", type text}, {"CORPORATE CLUSTER", type text}, {"AGENT NAME", type text}, {"CORP SHARE", type text}, {"AREA", type text}, {"DATE TRAVEL", type date}, {"PAX", Int64.Type}, {"NETT USD", type number}, {"BASIC FARE USD", type number}, {"WEEK NUM", Int64.Type}}, "en-US")
					in
					    Typed

	table DimCorporate

		column 'CORP CODE'
			dataType: string
			summarizeBy: none
			sourceColumn: CORP CODE

		column CORPORATE_NAME
			dataType: string
			summarizeBy: none
			sourceColumn: CORPORATE_NAME

		column CORPORATE_CLUSTER
			dataType: string
			summarizeBy: none
			sourceColumn: CORPORATE_CLUSTER

		column INDUSTRY_TYPE
			dataType: string
			summarizeBy: none
			sourceColumn: INDUSTRY_TYPE

		partition DimCorporate = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents(DataFolder & "\dim_corporate.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
					    Typed = Table.TransformColumnTypes(Nulls, {{"CORP CODE", type text}, {"CORPORATE_NAME", type text}, {"CORPORATE_CLUSTER", type text}, {"INDUSTRY_TYPE", type text}}, "en-US")
					in
					    Typed

	table DimBranchRegion

		column BO
			dataType: string
			summarizeBy: none
			sourceColumn: BO

		column REGION
			dataType: string
			summarizeBy: none
			sourceColumn: REGION

		partition DimBranchRegion = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents(DataFolder & "\dim_branch_region.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
					    Typed = Table.TransformColumnTypes(Nulls, {{"BO", type text}, {"REGION", type text}}, "en-US")
					in
					    Typed

	table DimRoute

		column route_vv
			dataType: string
			summarizeBy: none
			sourceColumn: route_vv

		column itinerary
			dataType: string
			summarizeBy: none
			sourceColumn: itinerary

		column dest
			dataType: string
			summarizeBy: none
			sourceColumn: dest

		column service_type
			dataType: string
			summarizeBy: none
			sourceColumn: service_type

		column subservice
			dataType: string
			summarizeBy: none
			sourceColumn: subservice

		column aircraft
			dataType: string
			summarizeBy: none
			sourceColumn: aircraft

		column status
			dataType: string
			summarizeBy: none
			sourceColumn: status

		partition DimRoute = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents(DataFolder & "\dim_route.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
					    Typed = Table.TransformColumnTypes(Nulls, {{"route_vv", type text}, {"itinerary", type text}, {"dest", type text}, {"service_type", type text}, {"subservice", type text}, {"aircraft", type text}, {"status", type text}}, "en-US")
					in
					    Typed

	table BookingPosition

		column RegionCode
			dataType: string
			summarizeBy: none
			sourceColumn: RegionCode

		column FltNbr
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: FltNbr

		column DOW
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: DOW

		column Bulan
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: Bulan

		column FlightType
			dataType: string
			summarizeBy: none
			sourceColumn: FlightType

		column SubServiceCode
			dataType: string
			summarizeBy: none
			sourceColumn: SubServiceCode

		column Tahun
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: Tahun

		column TipeAircraft
			dataType: string
			summarizeBy: none
			sourceColumn: TipeAircraft

		column STD
			dataType: dateTime
			summarizeBy: none
			sourceColumn: STD

		column ServiceTypeCode
			dataType: string
			summarizeBy: none
			sourceColumn: ServiceTypeCode

		column RouteVV
			dataType: string
			summarizeBy: none
			sourceColumn: RouteVV

		column Route
			dataType: string
			summarizeBy: none
			sourceColumn: Route

		column Depart
			dataType: string
			summarizeBy: none
			sourceColumn: Depart

		column Arrived
			dataType: string
			summarizeBy: none
			sourceColumn: Arrived

		column DiffDate
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: DiffDate

		column Book_Total
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: Book_Total

		column Capacity_Total
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: Capacity_Total

		column 'Departure Month' =
				FORMAT ( BookingPosition[STD], "yyyy-mm" )
			summarizeBy: none

		partition BookingPosition = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents(DataFolder & "\fact_booking_position.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
					    Typed = Table.TransformColumnTypes(Nulls, {{"RegionCode", type text}, {"FltNbr", Int64.Type}, {"DOW", Int64.Type}, {"Bulan", Int64.Type}, {"FlightType", type text}, {"SubServiceCode", type text}, {"Tahun", Int64.Type}, {"TipeAircraft", type text}, {"STD", type datetime}, {"ServiceTypeCode", type text}, {"RouteVV", type text}, {"Route", type text}, {"Depart", type text}, {"Arrived", type text}, {"DiffDate", Int64.Type}, {"Book_Total", Int64.Type}, {"Capacity_Total", Int64.Type}}, "en-US")
					in
					    Typed

	table SalesToFlown

		column route_vv
			dataType: string
			summarizeBy: none
			sourceColumn: route_vv

		column servicetypecode
			dataType: string
			summarizeBy: none
			sourceColumn: servicetypecode

		column sales_to_flown
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: sales_to_flown

		column trip_duration
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: trip_duration

		column trip_type
			dataType: string
			summarizeBy: none
			sourceColumn: trip_type

		column year
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: year

		column pax
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: pax

		column 'Trip Duration Group' =
				SWITCH (
				    TRUE (),
				    SalesToFlown[trip_type] = "OW", "One Way",
				    SalesToFlown[trip_duration] <= 3, "1-3 Days",
				    SalesToFlown[trip_duration] <= 7, "4-7 Days",
				    SalesToFlown[trip_duration] <= 14, "8-14 Days",
				    ">14 Days"
				)
			summarizeBy: none
			sortByColumn: 'Trip Duration Sort'

		column 'Trip Duration Sort' =
				SWITCH (
				    TRUE (),
				    SalesToFlown[trip_type] = "OW", 0,
				    SalesToFlown[trip_duration] <= 3, 1,
				    SalesToFlown[trip_duration] <= 7, 2,
				    SalesToFlown[trip_duration] <= 14, 3,
				    4
				)
			summarizeBy: none

		column 'Sales to Flown Group' =
				VAR d = SalesToFlown[sales_to_flown]
				RETURN
				    SWITCH (
				        TRUE (),
				        d = 0, "H",
				        d <= 7, "H-" & d,
				        d <= 30, "H-(8-30)",
				        d <= 60, "H-(31-60)",
				        d <= 120, "H-(61-120)",
				        "H-121+"
				    )
			summarizeBy: none
			sortByColumn: 'Sales to Flown Sort'

		column 'Sales to Flown Sort' =
				VAR d = SalesToFlown[sales_to_flown]
				RETURN
				    SWITCH ( TRUE (), d <= 7, d + 1, d <= 30, 9, d <= 60, 10, d <= 120, 11, 12 )
			summarizeBy: none

		partition SalesToFlown = m
			mode: import
			source =
					let
					    Source = Csv.Document(File.Contents(DataFolder & "\fact_sales_to_flown.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
					    Typed = Table.TransformColumnTypes(Nulls, {{"route_vv", type text}, {"servicetypecode", type text}, {"sales_to_flown", Int64.Type}, {"trip_duration", Int64.Type}, {"trip_type", type text}, {"year", Int64.Type}, {"pax", Int64.Type}}, "en-US")
					in
					    Typed

